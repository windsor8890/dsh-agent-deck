{
  "name": "dsh-agent-deck",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "description": "Agent Deck: cyberpunk HUD console that watches every working agent's thinking, tool calls and output live.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "assets/*.webp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/check.mjs",
    "check": "node scripts/check.mjs"
  }
}
